#!/bin/sh
set -eu
# dwm-weather: fetch, cache, and display weather for dwm-status bar
# Usage: dwm-weather status|detail|full

cache_dir="${XDG_RUNTIME_DIR:-/tmp}"
if [ ! -d "$cache_dir" ] || [ ! -w "$cache_dir" ]; then
	cache_dir="${TMPDIR:-/tmp}"
fi
cache_file="$cache_dir/dwm-status-weather.cache"
detail_cache="$cache_dir/dwm-status-weather-detail.cache"
coords_cache="$cache_dir/dwm-status-weather-coords.cache"
ttl=1200                             # 20 minutes
location="${DWM_WEATHER_LOCATION:-}" # empty = auto-detect by IP

wttr_url="wttr.in/${location}"

get_coords() {
	# If location is given as "lat,lon"
	case "$location" in
	*,*)
		printf '%s\n' "$location"
		return 0
		;;
	esac

	# Check cached coordinates (valid for 24h)
	if [ -f "$coords_cache" ]; then
		cage=$(($(date +%s) - $(stat -c %Y "$coords_cache" 2>/dev/null || echo 0)))
		if [ "$cage" -lt 86400 ]; then
			cat "$coords_cache"
			return 0
		fi
	fi

	coords=""
	if [ -n "$location" ]; then
		coords=$(curl -s --connect-timeout 2 --max-time 3 \
			"https://geocoding-api.open-meteo.com/v1/search?name=${location}&count=1" 2>/dev/null |
			awk -F'[:,]' '{
				for(i=1;i<=NF;i++) {
					if($i ~ /"latitude"/) lat=$(i+1);
					if($i ~ /"longitude"/) lon=$(i+1);
				}
				if(lat && lon) printf "%s %s %s\n", lat, lon, "'"$location"'";
			}')
	fi

	if [ -z "$coords" ]; then
		coords=$(curl -s --connect-timeout 2 --max-time 3 "http://ip-api.com/json" 2>/dev/null |
			awk -F'[:,]' '{
				for(i=1;i<=NF;i++) {
					if($i ~ /"lat"/) lat=$(i+1);
					if($i ~ /"lon"/) lon=$(i+1);
					if($i ~ /"city"/) city=$(i+1);
				}
				gsub(/[ "]/, "", city);
				if(lat && lon) printf "%s %s %s\n", lat, lon, city;
			}')
	fi

	if [ -z "$coords" ]; then
		coords="37.5658 126.9780 Seoul"
	fi

	printf '%s\n' "$coords" >"$coords_cache" 2>/dev/null || true
	printf '%s\n' "$coords"
}

fetch_openmeteo_compact() {
	coords=$(get_coords)
	lat=$(echo "$coords" | awk '{print $1}')
	lon=$(echo "$coords" | awk '{print $2}')
	[ -n "$lat" ] && [ -n "$lon" ] || return 1

	data=$(curl -s --connect-timeout 2 --max-time 4 \
		"https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code" 2>/dev/null)
	[ -n "$data" ] || return 1

	printf '%s' "$data" | awk -F'[:,]' '
	{
		for (i=1; i<=NF; i++) {
			if ($i ~ /"temperature_2m"/) temp = $(i+1);
			if ($i ~ /"weather_code"/) code = $(i+1);
		}
		if (temp == "" || code == "") exit 1;
		c = int(code);
		icon = "☀";
		if (c >= 1 && c <= 3) icon = "⛅";
		else if (c == 45 || c == 48) icon = "🌫";
		else if (c >= 51 && c <= 67) icon = "🌧";
		else if (c >= 71 && c <= 77) icon = "❄";
		else if (c >= 80 && c <= 82) icon = "🌧";
		else if (c >= 85 && c <= 86) icon = "❄";
		else if (c >= 95) icon = "⛈";
		sign = (temp > 0) ? "+" : "";
		printf "%s %s%.0f°C\n", icon, sign, temp;
	}'
}

fetch_openmeteo_detail() {
	coords=$(get_coords)
	lat=$(echo "$coords" | awk '{print $1}')
	lon=$(echo "$coords" | awk '{print $2}')
	city=$(echo "$coords" | awk '{print $3}')
	[ -n "$lat" ] && [ -n "$lon" ] || return 1

	data=$(curl -s --connect-timeout 3 --max-time 5 \
		"https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m" 2>/dev/null)
	[ -n "$data" ] || return 1

	printf '%s' "$data" | awk -F'[:,]' -v city="$city" '
	{
		for (i=1; i<=NF; i++) {
			if ($i ~ /"temperature_2m"/) temp = $(i+1);
			if ($i ~ /"apparent_temperature"/) feels = $(i+1);
			if ($i ~ /"relative_humidity_2m"/) hum = $(i+1);
			if ($i ~ /"wind_speed_10m"/) wind = $(i+1);
			if ($i ~ /"weather_code"/) code = $(i+1);
		}
		if (temp == "" || code == "") exit 1;
		c = int(code);
		icon = "☀"; desc = "Clear";
		if (c >= 1 && c <= 3) { icon = "⛅"; desc = "Partly Cloudy"; }
		else if (c == 45 || c == 48) { icon = "🌫"; desc = "Fog"; }
		else if (c >= 51 && c <= 67) { icon = "🌧"; desc = "Rain"; }
		else if (c >= 71 && c <= 77) { icon = "❄"; desc = "Snow"; }
		else if (c >= 80 && c <= 82) { icon = "🌧"; desc = "Showers"; }
		else if (c >= 85 && c <= 86) { icon = "❄"; desc = "Snow Showers"; }
		else if (c >= 95) { icon = "⛈"; desc = "Thunderstorm"; }
		sign = (temp > 0) ? "+" : "";
		fsign = (feels > 0) ? "+" : "";
		loc_str = (city != "") ? (" (" city ")") : "";
		printf "%s %s %s%.1f°C | Feels: %s%.1f°C | Humidity: %d%% | Wind: %.1fkm/h%s\n",
			icon, desc, sign, temp, fsign, feels, int(hum), wind, loc_str;
	}'
}

fetch_compact() {
	temp="$cache_file.$$"
	result=""
	# Primary: wttr.in
	if result=$(curl -s --connect-timeout 2 --max-time 3 \
		"${wttr_url}?format=%c+%t" 2>/dev/null) && [ -n "$result" ]; then
		result=$(printf '%s' "$result" | sed 's/\xef\xb8\x8f//g; s/\xef\xb8\x8e//g')
		printf '%s\n' "$result" >"$temp"
		mv -f "$temp" "$cache_file"
		return 0
	fi
	# Resilient fallback: Open-Meteo
	if result=$(fetch_openmeteo_compact 2>/dev/null) && [ -n "$result" ]; then
		printf '%s\n' "$result" >"$temp"
		mv -f "$temp" "$cache_file"
		return 0
	fi
	rm -f "$temp"
}

fetch_detail() {
	temp="$detail_cache.$$"
	result=""
	# Primary: wttr.in
	if result=$(curl -s --connect-timeout 3 --max-time 5 \
		"${wttr_url}?format=%c+%C+%t+|+Feels:+%f+|+Humidity:+%h+|+Wind:+%w" \
		2>/dev/null) && [ -n "$result" ]; then
		result=$(printf '%s' "$result" | sed 's/\xef\xb8\x8f//g; s/\xef\xb8\x8e//g')
		printf '%s\n' "$result" >"$temp"
		mv -f "$temp" "$detail_cache"
		return 0
	fi
	# Resilient fallback: Open-Meteo
	if result=$(fetch_openmeteo_detail 2>/dev/null) && [ -n "$result" ]; then
		printf '%s\n' "$result" >"$temp"
		mv -f "$temp" "$detail_cache"
		return 0
	fi
	rm -f "$temp"
}

case "${1:-status}" in
status)
	# Return cached compact weather, fetch in background if stale
	if [ -f "$cache_file" ]; then
		age=$(($(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0)))
		if [ "$age" -gt "$ttl" ]; then
			# The bar reads this output; holding the pipe would make it wait.
			(fetch_compact) >/dev/null 2>&1 &
		fi
		sed 's/\xef\xb8\x8f//g; s/\xef\xb8\x8e//g' "$cache_file"
	else
		(fetch_compact) >/dev/null 2>&1 &
		printf '\342\230\201 --\n'
	fi
	;;
detail)
	# Fetch detail and show Dunst notification
	fetch_detail
	if [ -f "$detail_cache" ]; then
		detail=$(cat "$detail_cache")
	else
		detail="Weather data unavailable"
	fi
	if command -v notify-send >/dev/null 2>&1; then
		notify-send \
			-a "Weather" \
			-u low \
			-h string:x-dunst-stack-tag:weather \
			-t 8000 \
			-i weather-clear \
			"Weather" "$detail"
	fi
	;;
full)
	if command -v xdotool >/dev/null 2>&1; then
		win_id=$(xdotool search --class "dwm-weather" 2>/dev/null | tail -n 1)
		if [ -n "$win_id" ]; then
			xdotool windowkill "$win_id" 2>/dev/null || true
			exit 0
		fi
	fi
	# Fallback preview if wttr.in fails
	full_wrapper="out=\$(curl -s --connect-timeout 2 '${wttr_url}' 2>/dev/null); if [ -n \"\$out\" ]; then printf '%s\n' \"\$out\" | head -40; else echo '=== Current Weather ==='; dwm-weather detail 2>/dev/null || true; [ -f '$detail_cache' ] && cat '$detail_cache'; fi; echo; echo 'Press any key to close'; read -n1 _"
	if command -v ghostty >/dev/null 2>&1; then
		ghostty --class="dwm-weather" --x11-instance-name="dwm-weather" --window-width=125 --window-height=40 -e sh -c "$full_wrapper" &
	elif command -v alacritty >/dev/null 2>&1; then
		alacritty --class "dwm-weather,dwm-weather" -o window.dimensions.columns=125 -o window.dimensions.lines=40 -e sh -c "$full_wrapper" &
	elif command -v kitty >/dev/null 2>&1; then
		kitty --class "dwm-weather" -o initial_window_width=125c -o initial_window_height=40c sh -c "$full_wrapper" &
	elif command -v dwm-terminal >/dev/null 2>&1; then
		dwm-terminal -e sh -c "$full_wrapper" &
	else
		xterm -class "dwm-weather" -geometry 125x40 -e sh -c "$full_wrapper" &
	fi
	;;
*)
	printf 'Usage: dwm-weather [status|detail|full]\n' >&2
	exit 1
	;;
esac
