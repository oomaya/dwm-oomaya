#!/bin/sh
set -eu
# dwm-clock: cycle clock display format / toggle 12hr<->24hr
# State stored in $XDG_RUNTIME_DIR/dwm-status-clock.state
# Sends SIGUSR1 to dwm-status to trigger immediate refresh

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
if [ ! -d "$runtime_dir" ] || [ ! -w "$runtime_dir" ]; then
    runtime_dir="${TMPDIR:-/tmp}"
fi
state_file="$runtime_dir/dwm-status-clock.state"
action="${1:-cycle}"

# Read current state (format_level:time_mode)
if [ -f "$state_file" ]; then
    IFS=: read -r level mode < "$state_file" 2>/dev/null || { level=0; mode=12; }
else
    level=0; mode=12
fi

case "$action" in
    cycle)  # Left-click: cycle format level 0->1->2->0
        level=$(( (level + 1) % 3 ))
        ;;
    toggle) # Right-click: toggle 12<->24
        if [ "$mode" = "12" ]; then mode=24; else mode=12; fi
        ;;
    *)
        printf 'Usage: dwm-clock [cycle|toggle]\n' >&2
        exit 1
        ;;
esac

printf '%s:%s\n' "$level" "$mode" > "$state_file"

# Signal dwm-status to refresh immediately
pkill -USR1 -f 'dwm-status$' 2>/dev/null || true
