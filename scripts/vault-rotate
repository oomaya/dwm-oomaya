#!/usr/bin/env bash
# ==============================================================================
# vault-rotate
# Automated Retention Engine for Antigravity & Omarchy Knowledge Vaults
#
# Retention Rules:
#   1. Hot -> Warm: Sessions in 'current/' older than HOT_DAYS (default: 7) move to 'history/'.
#   2. Warm -> Archive: Sessions in 'history/' older than WARM_DAYS (default: 30) are distilled
#      into a structured monthly markdown digest (history/archive/YYYY-MM_digest.md)
#      and raw session folders/sidecars are safely pruned.
#   3. Zero Token Bloat: Prunes .metadata.json clutter and eliminates circular links.
#
# Safety:
#   Runs in DRY-RUN preview mode by default unless --apply or -y is passed.
# ==============================================================================
set -euo pipefail

VAULT_DIR="${ANTIGRAVITY_VAULT_DIR:-$HOME/antigravity-vault}"
[ -d "$VAULT_DIR" ] || VAULT_DIR="$HOME/vault"

ARTIFACTS_DIR="$VAULT_DIR/antigravity-artifacts"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/antigravity"
LOG_FILE="$STATE_DIR/vault-rotate.log"

HOT_DAYS=7
WARM_DAYS=30
MODE="dry-run"
QUIET=0

mkdir -p "$STATE_DIR"

log() {
    local level="$1"
    shift
    local msg="$*"
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    echo "[$ts] [$level] $msg" >> "$LOG_FILE"
    if [ "$QUIET" -eq 0 ]; then
        case "$level" in
            INFO)  printf "\033[1;34m[%s]\033[0m %s\n" "$level" "$msg" ;;
            OK)    printf "\033[1;32m[%s]\033[0m %s\n" "$level" "$msg" ;;
            WARN)  printf "\033[1;33m[%s]\033[0m %s\n" "$level" "$msg" ;;
            DRY)   printf "\033[1;36m[%s]\033[0m %s\n" "DRY-RUN" "$msg" ;;
            *)     printf "[%s] %s\n" "$level" "$msg" ;;
        esac
    fi
}

show_help() {
    cat << 'EOF'
Usage: vault-rotate [OPTIONS]

Retention Engine & Token-Fire Firewall for the Antigravity Vault.

Options:
  --apply, -y       Execute real rotations and summarizations (default is dry-run)
  --dry-run, -n     Preview actions without touching disk (default)
  --check, -c       Report vault health, folder sizes, and retention status
  --quiet, -q       Suppress terminal output (appends to log only)
  --hot <days>      Days to keep in 'current/' before moving to 'history/' (default: 7)
  --warm <days>     Days before condensing 'history/' into monthly digests (default: 30)
  --help, -h        Show this message

Log File:
  ${XDG_STATE_HOME:-$HOME/.local/state}/antigravity/vault-rotate.log
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --apply|-y)
            MODE="apply"
            shift
            ;;
        --dry-run|-n)
            MODE="dry-run"
            shift
            ;;
        --check|-c)
            MODE="check"
            shift
            ;;
        --quiet|-q)
            QUIET=1
            shift
            ;;
        --hot)
            HOT_DAYS="$2"
            shift 2
            ;;
        --warm)
            WARM_DAYS="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            show_help
            exit 1
            ;;
    esac
done

if [ ! -d "$ARTIFACTS_DIR" ]; then
    log WARN "Artifacts directory not found at $ARTIFACTS_DIR"
    exit 0
fi

# Ensure mandatory layout exists
mkdir -p "$ARTIFACTS_DIR/current" \
         "$ARTIFACTS_DIR/history" \
         "$ARTIFACTS_DIR/history/archive" \
         "$ARTIFACTS_DIR/guides" \
         "$ARTIFACTS_DIR/refined" \
         "$ARTIFACTS_DIR/handoffs"

if [ "$MODE" = "check" ]; then
    log INFO "=== Vault Retention Health Check ==="
    log INFO "Vault Root: $VAULT_DIR"
    log INFO "Artifacts:  $ARTIFACTS_DIR"
    
    current_count=$(find "$ARTIFACTS_DIR/current" -type f | wc -l)
    history_count=$(find "$ARTIFACTS_DIR/history" -mindepth 1 -maxdepth 1 -type d ! -name "archive" | wc -l)
    archive_count=$(find "$ARTIFACTS_DIR/history/archive" -type f -name "*.md" | wc -l)
    guides_count=$(find "$ARTIFACTS_DIR/guides" -type f -name "*.md" | wc -l)
    json_count=$(find "$ARTIFACTS_DIR" -type f -name "*.metadata.json" | wc -l)
    
    log INFO "Active Sessions in current/:  $current_count files"
    log INFO "Warm Sessions in history/:    $history_count directories"
    log INFO "Monthly Archive Digests:      $archive_count files"
    log INFO "Curated Guides:               $guides_count files"
    if [ "$json_count" -gt 0 ]; then
        log WARN "Dead .metadata.json sidecars: $json_count (Run with --apply to purge)"
    else
        log OK "Sidecar Clutter:             0 (Clean)"
    fi
    
    if [ -L "$ARTIFACTS_DIR/antigravity-artifacts" ] || [ -e "$ARTIFACTS_DIR/antigravity-artifacts" ]; then
        log WARN "Circular symlink detected! (Run with --apply to eliminate)"
    fi
    exit 0
fi

log INFO "=== Vault Retention Engine Started (Mode: $MODE) ==="
log INFO "Target: $ARTIFACTS_DIR (Hot: ${HOT_DAYS}d, Warm: ${WARM_DAYS}d)"

# 0. Eradicate recursive symlink if found
if [ -L "$ARTIFACTS_DIR/antigravity-artifacts" ] || [ -e "$ARTIFACTS_DIR/antigravity-artifacts" ]; then
    if [ "$MODE" = "apply" ]; then
        rm -rf "$ARTIFACTS_DIR/antigravity-artifacts"
        log OK "Eradicated circular symlink 'antigravity-artifacts/antigravity-artifacts'"
    else
        log DRY "Would delete circular symlink 'antigravity-artifacts/antigravity-artifacts'"
    fi
fi

# 1. Prune dead .metadata.json clutter across the vault
json_files=$(find "$ARTIFACTS_DIR" -type f -name "*.metadata.json" 2>/dev/null || true)
if [ -n "$json_files" ]; then
    count=$(echo "$json_files" | wc -l)
    if [ "$MODE" = "apply" ]; then
        find "$ARTIFACTS_DIR" -type f -name "*.metadata.json" -delete
        log OK "Purged $count ephemeral .metadata.json sidecars"
    else
        log DRY "Would purge $count ephemeral .metadata.json sidecars"
    fi
fi

# 2. Hot -> Warm: Rotate files in current/ older than HOT_DAYS
now=$(date +%s)
hot_cutoff=$(( now - HOT_DAYS * 86400 ))
warm_cutoff=$(( now - WARM_DAYS * 86400 ))

moved_to_history=0
for f in "$ARTIFACTS_DIR/current"/*; do
    [ -e "$f" ] || continue
    mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo "$now")
    if [ "$mtime" -lt "$hot_cutoff" ]; then
        base="$(basename "$f")"
        if [ "$MODE" = "apply" ]; then
            archive_folder="$ARTIFACTS_DIR/history/rotated-$(date -d "@$mtime" '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')"
            mkdir -p "$archive_folder"
            mv "$f" "$archive_folder/"
            log OK "Moved hot artifact '$base' -> '$archive_folder/'"
        else
            log DRY "Would move hot artifact '$base' to history/ (mtime: $(date -d "@$mtime" '+%Y-%m-%d' 2>/dev/null || echo "$mtime"))"
        fi
        moved_to_history=$(( moved_to_history + 1 ))
    fi
done

# 3. Warm -> Archive: Condense sessions in history/ older than WARM_DAYS
condensed_sessions=0
for session_dir in "$ARTIFACTS_DIR/history"/*/; do
    [ -d "$session_dir" ] || continue
    session_name="$(basename "$session_dir")"
    [ "$session_name" != "archive" ] || continue

    # Detect session age by taking newest file inside session dir, or dir itself
    latest_file_mtime=$(find "$session_dir" -type f -name "*.md" -printf '%T@\n' 2>/dev/null | sort -rn | head -n 1 | cut -d. -f1 || echo "")
    if [ -n "$latest_file_mtime" ]; then
        mtime="$latest_file_mtime"
    else
        mtime=$(stat -c %Y "$session_dir" 2>/dev/null || stat -f %m "$session_dir" 2>/dev/null || echo "$now")
    fi

    # Prune empty directories
    if [ -z "$(find "$session_dir" -mindepth 1 -maxdepth 1 2>/dev/null)" ]; then
        if [ "$MODE" = "apply" ]; then
            rm -rf "$session_dir"
            log OK "Pruned empty session folder '$session_name'"
        else
            log DRY "Would prune empty session folder '$session_name'"
        fi
        continue
    fi

    if [ "$mtime" -lt "$warm_cutoff" ]; then
        month_label="$(date -d "@$mtime" '+%Y-%m' 2>/dev/null || date '+%Y-%m')"
        digest_file="$ARTIFACTS_DIR/history/archive/${month_label}_digest.md"

        if [ "$MODE" = "apply" ]; then
            mkdir -p "$ARTIFACTS_DIR/history/archive"
            if [ ! -f "$digest_file" ]; then
                cat > "$digest_file" << EOF
# Antigravity Historical Digest: ${month_label}

Archive of consolidated development sessions. Condensed to prevent AI token-fire.

| Date | Session ID | Deliverables / Topics |
| :--- | :--- | :--- |
EOF
            fi

            session_date="$(date -d "@$mtime" '+%Y-%m-%d' 2>/dev/null || echo "$month_label")"
            deliverables=""
            for md_file in "$session_dir"*.md; do
                [ -f "$md_file" ] || continue
                doc_title="$(grep -m 1 '^# ' "$md_file" 2>/dev/null | sed 's/^# //' | tr '|' '-' || basename "$md_file")"
                [ -n "$doc_title" ] || doc_title="$(basename "$md_file")"
                deliverables="${deliverables}${doc_title}; "
            done
            deliverables="${deliverables%; }"
            [ -n "$deliverables" ] || deliverables="Scratchpad / transcript session"

            echo "| ${session_date} | \`${session_name:0:8}\` | ${deliverables} |" >> "$digest_file"
            rm -rf "$session_dir"
            log OK "Condensed session '$session_name' -> archive/${month_label}_digest.md"
        else
            log DRY "Would condense session '$session_name' ($(date -d "@$mtime" '+%Y-%m-%d' 2>/dev/null || echo "$mtime")) into archive/${month_label}_digest.md"
        fi
        condensed_sessions=$(( condensed_sessions + 1 ))
    fi
done

if [ "$MODE" = "dry-run" ]; then
    log INFO "Preview complete. To execute real changes, run: vault-rotate --apply"
else
    log OK "Rotation complete. Total hot moved: $moved_to_history, Warm condensed: $condensed_sessions"
fi
