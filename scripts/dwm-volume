#!/usr/bin/env bash
set -euo pipefail

# dwm-volume: POSIX/bash audio control with Dunst OSD and mixer launcher
# Conforms to Zero Hardcoded Literals and Bloat-Free POSIX standards

action="${1:-status}"
step="${2:-5%}"

get_volume() {
	local vol=""
	if command -v pactl >/dev/null 2>&1; then
		vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
			awk 'match($0, /[0-9]+%/) { print substr($0, RSTART, RLENGTH - 1); exit }') || vol=""
	fi
	if [[ -z $vol ]] && command -v wpctl >/dev/null 2>&1; then
		vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null |
			awk '{ print int(($2 * 100) + 0.5) }') || vol=""
	fi
	echo "${vol:-50}"
}

is_muted() {
	if command -v pactl >/dev/null 2>&1; then
		if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q "yes"; then
			return 0
		fi
	elif command -v wpctl >/dev/null 2>&1; then
		if wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q "[MUTED]"; then
			return 0
		fi
	fi
	return 1
}

notify_volume() {
	local vol
	vol=$(get_volume)
	if is_muted; then
		notify-send \
			-a "Volume" \
			-u low \
			-h string:x-dunst-stack-tag:volume \
			-h int:value:0 \
			-t 1500 \
			-i audio-volume-muted \
			"Volume Muted" "0%"
	else
		notify-send \
			-a "Volume" \
			-u low \
			-h string:x-dunst-stack-tag:volume \
			-h int:value:"$vol" \
			-t 1500 \
			-i audio-volume-high \
			"Volume: ${vol}%" ""
	fi
}

case "$action" in
	up)
		if command -v pactl >/dev/null 2>&1; then
			pactl set-sink-volume @DEFAULT_SINK@ "+${step}"
		elif command -v wpctl >/dev/null 2>&1; then
			wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}+"
		fi
		notify_volume
		;;
	down)
		if command -v pactl >/dev/null 2>&1; then
			pactl set-sink-volume @DEFAULT_SINK@ "-${step}"
		elif command -v wpctl >/dev/null 2>&1; then
			wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}-"
		fi
		notify_volume
		;;
	mute)
		if command -v pactl >/dev/null 2>&1; then
			pactl set-sink-mute @DEFAULT_SINK@ toggle
		elif command -v wpctl >/dev/null 2>&1; then
			wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
		fi
		notify_volume
		;;
	mixer)
		if command -v pavucontrol >/dev/null 2>&1; then
			pavucontrol &
		elif command -v alsamixer >/dev/null 2>&1; then
			if command -v xdotool >/dev/null 2>&1; then
				win_id=$(xdotool search --class "alsamixer" 2>/dev/null | tail -n 1)
				if [[ -n $win_id ]]; then
					xdotool windowkill "$win_id" 2>/dev/null || true
					exit 0
				fi
			fi
			if command -v ghostty >/dev/null 2>&1; then
				ghostty --class="alsamixer" --x11-instance-name="alsamixer" --window-width=90 --window-height=26 -e alsamixer &
			elif command -v alacritty >/dev/null 2>&1; then
				alacritty --class "alsamixer,alsamixer" -o window.dimensions.columns=90 -o window.dimensions.lines=26 -e alsamixer &
			elif command -v kitty >/dev/null 2>&1; then
				kitty --class "alsamixer" -o initial_window_width=90c -o initial_window_height=26c alsamixer &
			elif command -v dwm-terminal >/dev/null 2>&1; then
				dwm-terminal -e alsamixer &
			else
				xterm -class "alsamixer" -geometry 90x26 -e alsamixer &
			fi
		fi
		;;
	status)
		vol=$(get_volume)
		echo "${vol}%"
		;;
	*)
		echo "Usage: $0 [up|down|mute|mixer|status]" >&2
		exit 1
		;;
esac
