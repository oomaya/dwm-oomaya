#!/bin/sh
set -eu

config=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/shell.qml

if [ ! -f "$config" ]; then
	config=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-oomaya/quickshell/shell.qml
fi
if [ ! -f "$config" ]; then
	config=${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/config/quickshell/shell.qml
fi
if [ ! -f "$config" ]; then
	config=${XDG_DATA_HOME:-$HOME/.local/share}/dwm-titus/config/quickshell/shell.qml
fi

# If quickshell is active, invoke the new interactive Keybindings Palette via IPC
if command -v quickshell >/dev/null 2>&1 && pgrep -x quickshell >/dev/null 2>&1; then
	exec quickshell ipc --path "$config" call controlcenter openKeybinds
fi

# Fallback: interactive executable dmenu palette
if command -v dmenu >/dev/null 2>&1; then
	control_helper="dwm-quickshell-controlcenter"
	exec_helper="dwm-keybind-exec"

	if ! command -v "$control_helper" >/dev/null 2>&1; then
		if [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/$control_helper" ]; then
			control_helper="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/$control_helper"
		elif [ -x "$(dirname -- "$0")/$control_helper" ]; then
			control_helper="$(dirname -- "$0")/$control_helper"
		fi
	fi

	if ! command -v "$exec_helper" >/dev/null 2>&1; then
		if [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/$exec_helper" ]; then
			exec_helper="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/$exec_helper"
		elif [ -x "$(dirname -- "$0")/$exec_helper" ]; then
			exec_helper="$(dirname -- "$0")/$exec_helper"
		fi
	fi

	if [ -x "$control_helper" ]; then
		choice=$("$control_helper" keybinds | awk -F'\t' '{ printf "%-24s │ %-32s │ [%s]\t%s\n", $1, $2, $3, $0 }' | dmenu -i -l 22 -p "DWM Palette >")
		if [ -n "$choice" ]; then
			raw=$(printf '%s\n' "$choice" | cut -f2-)
			exec "$exec_helper" "$raw"
		fi
	fi
fi
