#!/bin/sh
set -eu

config=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/shell.qml

if [ ! -f "$config" ]; then
	config=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-oomaya/quickshell/shell.qml
fi
if [ ! -f "$config" ]; then
	config=${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/config/quickshell/shell.qml
fi
if [ ! -f "$config" ]; then
	config=${XDG_DATA_HOME:-$HOME/.local/share}/dwm-titus/config/quickshell/shell.qml
fi

# If quickshell is active, invoke the new interactive Keybindings Palette via IPC
if command -v quickshell >/dev/null 2>&1 && pgrep -x quickshell >/dev/null 2>&1; then
	exec quickshell ipc --path "$config" call controlcenter openKeybinds
fi

# Fallback: interactive executable dmenu palette
if command -v dmenu >/dev/null 2>&1; then
	control_helper=""
	if command -v dwm-quickshell-controlcenter >/dev/null 2>&1; then
		control_helper=$(command -v dwm-quickshell-controlcenter)
	elif [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/dwm-quickshell-controlcenter" ]; then
		control_helper="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/dwm-quickshell-controlcenter"
	elif [ -x "$(dirname -- "$0")/dwm-quickshell-controlcenter" ]; then
		control_helper="$(dirname -- "$0")/dwm-quickshell-controlcenter"
	fi

	exec_helper=""
	if command -v dwm-keybind-exec >/dev/null 2>&1; then
		exec_helper=$(command -v dwm-keybind-exec)
	elif [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/dwm-keybind-exec" ]; then
		exec_helper="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-oomaya/scripts/dwm-keybind-exec"
	elif [ -x "$(dirname -- "$0")/dwm-keybind-exec" ]; then
		exec_helper="$(dirname -- "$0")/dwm-keybind-exec"
	fi

	if [ -n "$control_helper" ] && [ -x "$control_helper" ]; then
		choice=$("$control_helper" keybinds | awk -F'\t' '{ printf "%-24s │ %-32s │ [%s]\t%s\n", $1, $2, $3, $0 }' | dmenu -i -l 22 -p "DWM Palette >")
		if [ -n "$choice" ]; then
			raw=$(printf '%s\n' "$choice" | cut -f2-)
			[ -n "$exec_helper" ] && exec "$exec_helper" "$raw"
		fi
	fi
fi
