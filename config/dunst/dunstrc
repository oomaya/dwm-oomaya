# Tokyo Night dunstrc for dwm-oomaya
# Conforms to Sharp-Corner Aesthetic Law (corner_radius = 0) and Bloat-Free POSIX standard

[global]
    monitor = 0
    follow = keyboard
    width = (320, 500)
    height = 300
    origin = top-right
    offset = 16x46
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 220
    progress_bar_max_width = 360
    progress_bar_corner_radius = 0

    ### Spacing & Borders ###
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 18
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 2
    frame_color = "#7aa2f7"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Typography ###
    font = "JetBrainsMono Nerd Font 14"
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### Sharp-Corner Aesthetic Law (Absolute Strict Invariant) ###
    corner_radius = 0

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#414868"
    timeout = 4
    highlight = "#7aa2f7"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
